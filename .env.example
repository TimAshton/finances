# Mortgage (primary residence)
MORTGAGE_LENDER=
MORTGAGE_ACCOUNT=
MORTGAGE_BALANCE=
MORTGAGE_RATE=
MORTGAGE_MINIMUM=
MORTGAGE_DUE_DAY=
MORTGAGE_URL=
MORTGAGE_PURCHASE_PRICE=
# Current estimated market value (e.g. a Zillow Zestimate) — update
# periodically by hand; balance vs. this is what the app shows as equity.
MORTGAGE_MARKET_VALUE=

# Rental Properties (add as many blocks as needed)
RENTAL1_NAME=
RENTAL1_ACCOUNT=
RENTAL1_BALANCE=
RENTAL1_RATE=
RENTAL1_MINIMUM=
RENTAL1_DUE_DAY=
RENTAL1_URL=
RENTAL1_PURCHASE_PRICE=
RENTAL1_MARKET_VALUE=

# Auto Loan
# AUTO_NAME is optional — e.g. the car itself ("2022 Honda Civic") — and is
# shown as the account name instead of the lender when set.
AUTO_NAME=
AUTO_LENDER=
AUTO_ACCOUNT=
AUTO_BALANCE=
AUTO_RATE=
AUTO_MINIMUM=
AUTO_DUE_DAY=
AUTO_URL=

