# Utilities / Subscriptions
ELECTRIC_PROVIDER=
ELECTRIC_AMOUNT=
ELECTRIC_DUE_DAY=
ELECTRIC_URL=

GAS_PROVIDER=
GAS_AMOUNT=
GAS_DUE_DAY=
GAS_URL=

# WATER_AMOUNT is a per-bill estimate (the bill varies) used for planning
# totals; log the actual amount as a Payment each cycle. WATER_FREQUENCY
# defaults to "monthly" if omitted — set to "bimonthly" for water billed
# every other month.
WATER_PROVIDER=
WATER_AMOUNT=
WATER_FREQUENCY=bimonthly
WATER_DUE_DAY=
WATER_URL=

INTERNET_PROVIDER=
INTERNET_AMOUNT=
INTERNET_DUE_DAY=
INTERNET_URL=

# One policy can cover multiple vehicles — just note that in the provider
# name, e.g. "Progressive (2 cars)".
INSURANCE_PROVIDER=
INSURANCE_AMOUNT=
INSURANCE_DUE_DAY=
INSURANCE_URL=
